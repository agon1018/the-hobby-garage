---
import RoomSidebar from '../../components/RoomSidebar.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="プライベートの部屋" noindex>
  <RoomSidebar
    currentPath="/private"
    breadcrumbs={[
      { href: '/', label: '趣味のガレージ' },
      { label: 'プライベートの部屋' },
    ]}
  >
    <main class="page">
      <header class="title-head">
        <p class="label">Private Room</p>
        <h1>プライベートの部屋</h1>
        <p>旅行のしおりをはじめ、さまざまな個人的な記録をまとめる鍵付きの部屋です。</p>
      </header>

      <section class="empty">
        <p class="kicker">Private Notes</p>
        <h2>最初の記録を準備中です</h2>
        <p>ここにテーマごとのページや記録を追加していきます。</p>
      </section>
    </main>
  </RoomSidebar>
</Layout>

<style>
  .page {
    min-height: 100vh;
    padding: 2rem 1.2rem 3.2rem;
    color: #273044;
    font-family: 'BIZ UDPGothic', 'Noto Sans JP', sans-serif;
    background:
      radial-gradient(circle at 88% 16%, rgba(57, 134, 155, 0.16), transparent 36%),
      radial-gradient(circle at 12% 85%, rgba(218, 148, 68, 0.14), transparent 34%),
      #f8faf9;
  }

  .title-head,
  .empty {
    max-width: 980px;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .title-head {
    padding: 1rem 1.15rem 1.1rem;
    overflow: hidden;
    position: relative;
    border: 1px solid #cfdee1;
    border-radius: 1.15rem;
    background: #fff;
    box-shadow: 0 12px 24px rgba(39, 48, 68, 0.08);
  }

  .title-head::after {
    content: '';
    position: absolute;
    inset: auto 14% 0;
    height: 5px;
    background: linear-gradient(90deg, #39869b, #da9444, #39869b);
  }

  .label,
  .kicker {
    margin: 0;
    color: #32798c;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.35rem 0 0.8rem;
    color: #204f5b;
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    font-size: clamp(1.75rem, 3.5vw, 2.6rem);
    letter-spacing: 0.04em;
  }

  .title-head > p:last-child,
  .empty p:last-child {
    margin: 0;
    line-height: 1.7;
  }

  .empty {
    margin-top: 1rem;
    padding: 1.2rem;
    border: 1px solid #cfdee1;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 8px 16px rgba(39, 48, 68, 0.06);
  }

  .empty h2 {
    margin: 0.3rem 0 0.5rem;
    color: #204f5b;
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
  }

  @media (max-width: 700px) {
    .page {
      padding: 1rem 0.8rem 2rem;
    }

    .title-head {
      padding: 0.8rem 0.85rem 0.9rem;
      border-radius: 0.9rem;
    }

    h1 {
      margin: 0.25rem 0 0.5rem;
      font-size: 1.45rem;
    }

    .title-head > p:last-child,
    .empty p:last-child {
      font-size: 0.85rem;
      line-height: 1.55;
    }
  }
</style>
