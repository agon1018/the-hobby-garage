---
import RoomSidebar from '../../components/RoomSidebar.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="プライベートの部屋" noindex>
  <RoomSidebar
    currentPath="/private"
    breadcrumbs={[
      { href: '/', label: '趣味のガレージ' },
      { label: 'プライベートの部屋' },
    ]}
  >
    <main class="page">
      <header class="title-head">
        <p class="label">Private Room</p>
        <h1>プライベートの部屋</h1>
        <p>旅行のしおりをはじめ、さまざまな個人的な記録をまとめる鍵付きの部屋です。</p>
      </header>

      <section class="card-grid">
        <a class="entry-card" href="/private/nagoya-uru">
          <p class="entry-tag">旅行・ライブ</p>
          <p class="entry-date">2026年8月11日〜13日（2泊3日）</p>
          <h2>名古屋・Uru ライブ旅行</h2>
          <p>Uru Tour 2026「tone」観覧。ジャズドリーム長島・栄パルコ・haera でショッピング、スカイプロムナードで夜景も。</p>
          <span class="entry-go">記録を見る →</span>
        </a>
        <a class="entry-card" href="/private/hakusan-daishoten">
          <p class="entry-tag">競馬観戦</p>
          <p class="entry-date">2026年9月22日（火・休日）</p>
          <h2>白山大賞典 観戦</h2>
          <p>金沢競馬場でGⅢ白山大賞典を観戦。友人3人で日帰り遠征。</p>
          <span class="entry-go">記録を見る →</span>
        </a>
        <a class="entry-card" href="/private/kyoto-racecourse">
          <p class="entry-tag">旅行</p>
          <p class="entry-date">2026年10月17日〜18日</p>
          <h2>京都競馬場旅行</h2>
          <p>京都競馬場でGⅠ秋華賞を観戦。1泊2日の京都旅行。</p>
          <span class="entry-go">記録を見る →</span>
        </a>
      </section>
    </main>
  </RoomSidebar>
</Layout>

<style>
  .page {
    min-height: 100vh;
    padding: 2rem 1.2rem 3.2rem;
    color: #273044;
    font-family: 'BIZ UDPGothic', 'Noto Sans JP', sans-serif;
    background:
      radial-gradient(circle at 88% 16%, rgba(57, 134, 155, 0.16), transparent 36%),
      radial-gradient(circle at 12% 85%, rgba(218, 148, 68, 0.14), transparent 34%),
      #f8faf9;
  }

  .title-head,
  .empty {
    max-width: 980px;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .title-head {
    padding: 1rem 1.15rem 1.1rem;
    overflow: hidden;
    position: relative;
    border: 1px solid #cfdee1;
    border-radius: 1.15rem;
    background: #fff;
    box-shadow: 0 12px 24px rgba(39, 48, 68, 0.08);
  }

  .title-head::after {
    content: '';
    position: absolute;
    inset: auto 14% 0;
    height: 5px;
    background: linear-gradient(90deg, #39869b, #da9444, #39869b);
  }

  .label,
  .kicker {
    margin: 0;
    color: #32798c;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.35rem 0 0.8rem;
    color: #204f5b;
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    font-size: clamp(1.75rem, 3.5vw, 2.6rem);
    letter-spacing: 0.04em;
  }

  .title-head > p:last-child {
    margin: 0;
    line-height: 1.7;
  }

  .card-grid {
    margin-top: 1rem;
    max-width: 980px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.85rem;
  }

  .entry-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    position: relative;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid #cfdee1;
    border-radius: 1rem;
    padding: 1.05rem 1.1rem 1.05rem;
    box-shadow: 0 8px 18px rgba(39, 48, 68, 0.06);
    overflow: hidden;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .entry-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, #39869b, #da9444);
  }

  .entry-card:hover {
    transform: translateY(-4px);
    border-color: #8ec6d4;
    box-shadow: 0 14px 28px rgba(57, 134, 155, 0.18);
  }

  .entry-card:focus-visible {
    outline: 3px solid #39869b;
    outline-offset: 2px;
    transform: translateY(-4px);
  }

  .entry-tag {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #da9444;
    text-transform: uppercase;
  }

  .entry-date {
    margin: 0.1rem 0 0;
    font-size: 0.78rem;
    color: #6b8594;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .entry-card h2 {
    margin: 0;
    font-size: 1.1rem;
    color: #204f5b;
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    line-height: 1.4;
  }

  .entry-card p:not(.entry-tag) {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.65;
    color: #3e5560;
    flex: 1;
  }

  .entry-go {
    margin-top: 0.4rem;
    font-size: 0.83rem;
    font-weight: 700;
    color: #32798c;
  }

  @media (max-width: 700px) {
    .page {
      padding: 1rem 0.8rem 2rem;
    }

    .title-head {
      padding: 0.8rem 0.85rem 0.9rem;
      border-radius: 0.9rem;
    }

    h1 {
      margin: 0.25rem 0 0.5rem;
      font-size: 1.45rem;
    }

    .title-head > p:last-child {
      font-size: 0.85rem;
      line-height: 1.55;
    }

    .card-grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .entry-card {
      border-radius: 0.85rem;
      padding: 0.85rem 0.9rem 0.9rem;
    }

    .entry-card h2 {
      font-size: 1rem;
    }
  }
</style>
