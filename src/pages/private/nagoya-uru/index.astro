---
import RoomSidebar from '../../../components/RoomSidebar.astro';
import Layout from '../../../layouts/Layout.astro';

/* ----------------------------------------------------------------
   スケジュールデータ（2泊3日）
   status: 'confirmed' = 確定  |  'pending' = 未定・後日決定
   badge:  '確定' | '目安' | '未定' | '当日'
---------------------------------------------------------------- */
type Link = {
  label: string;
  href: string;
  icon: 'map' | 'web' | 'train';
};

type ScheduleItem = {
  time: string;
  badge: '確定' | '目安' | '未定' | '当日';
  title: string;
  body: string;
  status: 'confirmed' | 'pending';
  links?: Link[];
};

// ── 8月11日（火・祝）────────────────────────────────────────────
const day1: ScheduleItem[] = [
  {
    time: '08:00',
    badge: '確定',
    title: '富山IC 出発',
    body: '富山ICから北陸自動車道・東海北陸道・伊勢湾岸道を利用して名古屋方面へ出発。',
    status: 'confirmed',
    links: [
      {
        label: '富山IC → ジャズドリーム長島（経路）',
        href: 'https://www.google.com/maps/dir/?api=1&origin=富山インターチェンジ,富山県&destination=三井アウトレットパーク+ジャズドリーム長島,三重県桑名市長島町浦安333&travelmode=driving',
        icon: 'map',
      },
    ],
  },
  {
    time: '12:00',
    badge: '確定',
    title: 'ジャズドリーム長島 ショッピング',
    body: '三井アウトレットパーク ジャズドリーム長島に立ち寄ってショッピング。',
    status: 'confirmed',
    links: [
      {
        label: 'ジャズドリーム長島（公式）',
        href: 'https://mitsui-shopping-park.com/mop/nagashima/',
        icon: 'web',
