        label: 'スカイプロムナード（公式）',
        href: 'https://www.midland-square.com/sky-promenade/',
        icon: 'web',
      },
      {
        label: 'ミッドランドスクエア（地図）',
        href: 'https://www.google.com/maps/search/?api=1&query=ミッドランドスクエア,名古屋市中村区名駅4',
        icon: 'map',
      },
    ],
  },
  {
    time: '23:00〜0:00',
    badge: '確定',
    title: '一番出口のれん街 夕食',
    body: '栄・一番出口のれん街で遅めの夕食。詳細は後日記入。',
    status: 'confirmed',
    links: [
      {
        label: '一番出口のれん街（公式）',
        href: 'https://sakae-norengai.com/',
        icon: 'web',
      },
      {
        label: '一番出口のれん街（地図）',
        href: 'https://www.google.com/maps/search/?api=1&query=一番出口のれん街+名古屋+栄',
        icon: 'map',
      },
    ],
  },
  {
    time: '0:00',
    badge: '確定',
    title: 'ホテル帰宅 😏 ニンマリな夜',
    body: 'ホテルに戻る。ニンマリな夜。',
    status: 'confirmed',
  },
];

// ── 8月13日（木）────────────────────────────────────────────
const day3: ScheduleItem[] = [
  {
    time: '11:00〜15:00',
    badge: '確定',
    title: 'haera ショッピング・グルメ',
    body: 'haeraでショッピングと食事を楽しむ。ピエールマリコリーニでカフェ、Le Beurre Noisetteでランチ、和甘でどらやき。',
    status: 'confirmed',
    links: [
      {
        label: 'haera（公式）',
        href: 'https://haera.parco.jp/',
        icon: 'web',
      },
      {
        label: 'haera（地図）',
        href: 'https://www.google.com/maps/search/?api=1&query=haera+名古屋+栄',
        icon: 'map',
      },
      {
        label: 'ピエールマリコリーニ',
        href: 'https://haera.parco.jp/shop/detail/?cd=000032',
        icon: 'web',
      },
      {
        label: 'Café/Bistro Parisien Le Beurre Noisette',
        href: 'https://haera.parco.jp/shop/detail/?cd=000028',
        icon: 'web',
      },
      {
        label: '和甘',
        href: 'https://haera.parco.jp/shop/detail/?cd=000040',
        icon: 'web',
      },
    ],
  },
  {
    time: '15:00',
    badge: '確定',
    title: '富山へ出発',
    body: '名古屋を出発し、富山へ向けてドライブ。',
    status: 'confirmed',
    links: [
      {
        label: 'ベッセルイン栄駅前 → 富山IC（経路）',
        href: 'https://www.google.com/maps/dir/?api=1&origin=ベッセルイン栄駅前ホテル,名古屋市中区栄&destination=富山インターチェンジ,富山県&travelmode=driving',
        icon: 'map',
      },
    ],
  },
  {
    time: '19:00〜20:00',
    badge: '確定',
    title: '富山県総合運動公園 夜の散歩',
    body: '富山県総合運動公園で夜の散歩を楽しんで解散。',
    status: 'confirmed',
    links: [
      {
        label: '富山県総合運動公園（公式）',
