        href: 'https://www.google.com/maps/search/?api=1&query=名古屋パルコ,名古屋市中区栄3',
        icon: 'map',
      },
    ],
  },
  {
    time: '15:00〜17:00',
    badge: '確定',
    title: 'キング観光サウザンド栄住吉店 スロット＆パチンコ',
    body: 'ライブ前の時間を使ってスロット＆パチンコで遊ぶ。',
    status: 'confirmed',
    links: [
      {
        label: 'キング観光サウザンド栄住吉店（DMM）',
        href: 'https://p-town.dmm.com/shops/aichi/5730',
        icon: 'web',
      },
      {
        label: 'キング観光サウザンド栄住吉店（地図）',
        href: 'https://www.google.com/maps/search/?api=1&query=キング観光サウザンド栄住吉店,名古屋市中区',
        icon: 'map',
      },
    ],
  },
  {
    time: '18:00〜21:00',
    badge: '確定',
