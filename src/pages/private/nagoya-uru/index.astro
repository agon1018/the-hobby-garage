---

<Layout title="名古屋・Uru ライブ旅行 — プライベートの部屋" noindex>
  <RoomSidebar
    currentPath="/private/nagoya-uru"
    breadcrumbs={[
      { href: '/', label: '趣味のガレージ' },
      { href: '/private', label: 'プライベートの部屋' },
      { label: '名古屋・Uru ライブ旅行' },
    ]}
  >
    <main class="page">

      {/* ── ヘッダー ── */}
      <header class="title-head">
        <p class="label">2 Nights 3 Days · 2026</p>
        <h1>名古屋・Uru ライブ旅行</h1>
        <p class="subtitle">2026年8月11日（火・祝）〜13日（木）｜2泊3日｜富山から名古屋</p>
      </header>

      {/* ── 旅行概要カード ── */}
      <section class="overview-section">
        <h2 class="section-title"><span>旅行概要</span></h2>
        <div class="overview-grid">
          <div class="ov-item">
            <span class="ov-key">日程</span>
            <span class="ov-val">8月11日〜13日（2泊3日）</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">出発地</span>
            <span class="ov-val">富山</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">目的地</span>
            <span class="ov-val">名古屋・栄エリア</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">宿泊</span>
            <span class="ov-val">ベッセルイン栄駅前ホテル（2泊）</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">移動手段</span>
            <span class="ov-val">自家用車</span>
          </div>
          <div class="ov-item ov-item--highlight">
            <span class="ov-key">メインイベント</span>
            <span class="ov-val">🎵 Uru Tour 2026「tone」（8/12）</span>
          </div>
        </div>
      </section>

      {/* ── 凡例 ── */}
      <div class="legend">
        <span class="legend-item"><span class="badge badge--confirmed">確定</span>確定した予定</span>
        <span class="legend-item"><span class="badge badge--estimate">目安</span>おおよその時刻</span>
        <span class="legend-item"><span class="badge badge--pending">未定</span>後日決定する予定</span>
      </div>

      {/* ── 8月11日 タイムライン ── */}
      <section class="day-section">
        <div class="day-header">
          <div class="day-badge">8.11</div>
          <div class="day-info">
            <p class="day-date">8月11日（火・祝）山の日</p>
            <p class="day-theme">名古屋到着・ショッピング・夕食</p>
          </div>
        </div>
        <ol class="timeline">
          {day1.map((item) => (
            <li class={`tl-item tl-item--${item.status}`}>
              <div class="tl-time">
                <span class="tl-time-text">{item.time}</span>
                <span class={`badge badge--${
                  item.badge === '確定' ? 'confirmed' :
                  item.badge === '目安' ? 'estimate' :
                  item.badge === '当日' ? 'today' : 'pending'
                }`}>{item.badge}</span>
              </div>
              <div class="tl-line" aria-hidden="true">
                <span class="tl-dot"></span>
              </div>
              <div class="tl-card">
                <h3 class="tl-title">{item.title}</h3>
                <p class="tl-body">{item.body}</p>
                {item.links && item.links.length > 0 && (
                  <ul class="tl-links">
                    {item.links.map((link) => (
                      <li>
                        <a
                          class={`tl-link tl-link--${link.icon}`}
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.icon === 'map' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          )}
                          {link.icon === 'web' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                          )}
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {/* ── 8月12日 タイムライン ── */}
      <section class="day-section">
        <div class="day-header day-header--live">
          <div class="day-badge day-badge--live">8.12</div>
          <div class="day-info">
            <p class="day-date">8月12日（水）</p>
            <p class="day-theme">🎵 Uru Tour 2026「tone」ライブ当日</p>
          </div>
        </div>
        <ol class="timeline">
          {day2.map((item) => (
            <li class={`tl-item tl-item--${item.status}`}>
              <div class="tl-time">
                <span class="tl-time-text">{item.time}</span>
                <span class={`badge badge--${
                  item.badge === '確定' ? 'confirmed' :
                  item.badge === '目安' ? 'estimate' :
                  item.badge === '当日' ? 'today' : 'pending'
                }`}>{item.badge}</span>
              </div>
              <div class="tl-line" aria-hidden="true">
                <span class="tl-dot"></span>
              </div>
              <div class="tl-card">
                <h3 class="tl-title">{item.title}</h3>
                <p class="tl-body">{item.body}</p>
                {item.links && item.links.length > 0 && (
                  <ul class="tl-links">
                    {item.links.map((link) => (
                      <li>
                        <a
                          class={`tl-link tl-link--${link.icon}`}
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.icon === 'map' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          )}
                          {link.icon === 'web' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                          )}
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {/* ── 8月13日 タイムライン ── */}
      <section class="day-section">
        <div class="day-header">
          <div class="day-badge">8.13</div>
          <div class="day-info">
            <p class="day-date">8月13日（木）</p>
            <p class="day-theme">haera・富山へ帰路</p>
          </div>
        </div>
        <ol class="timeline">
          {day3.map((item) => (
            <li class={`tl-item tl-item--${item.status}`}>
              <div class="tl-time">
                <span class="tl-time-text">{item.time}</span>
                <span class={`badge badge--${
                  item.badge === '確定' ? 'confirmed' :
                  item.badge === '目安' ? 'estimate' :
                  item.badge === '当日' ? 'today' : 'pending'
                }`}>{item.badge}</span>
              </div>
              <div class="tl-line" aria-hidden="true">
                <span class="tl-dot"></span>
              </div>
              <div class="tl-card">
                <h3 class="tl-title">{item.title}</h3>
                <p class="tl-body">{item.body}</p>
                {item.links && item.links.length > 0 && (
                  <ul class="tl-links">
                    {item.links.map((link) => (
                      <li>
                        <a
                          class={`tl-link tl-link--${link.icon}`}
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.icon === 'map' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          )}
                          {link.icon === 'web' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                          )}
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

    </main>
  </RoomSidebar>
</Layout>

<style>
  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     ページ基盤
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .page {
    --teal:      #39869b;
    --teal-mid:  #8ec6d4;
    --teal-lt:   #cfdee1;
    --purple:    #7c5cbf;
    --purple-lt: #e0d8f5;
    --gold:      #da9444;
    --gold-lt:   #f0d09a;
    --ink:       #273044;
    --ink-mid:   #3e5560;
    --ink-lt:    #6b8594;
    --bg:        #f8faf9;
    --card-bg:   #ffffff;
    --pend-bg:   #f5f8f9;

