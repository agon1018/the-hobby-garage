        icon: 'map',
      },
    ],
  },
  {
    time: '17:00',
    badge: '確定',
    title: 'ホテルへ出発',
    body: 'ジャズドリーム長島を出発し、名古屋・栄エリアのホテルへ向かう。',
    status: 'confirmed',
  },
  {
    time: '18:30',
    badge: '確定',
    title: 'ベッセルイン栄駅前ホテル 到着・チェックイン',
    body: '栄駅前のホテルにチェックイン。2泊お世話になるベースキャンプ。',
    status: 'confirmed',
    links: [
      {
        label: 'ベッセルイン栄駅前ホテル（公式）',
        href: 'https://www.vessel-hotel.jp/inn/sakae/',
        icon: 'web',
      },
      {
        label: 'ベッセルイン栄駅前ホテル（地図）',
        href: 'https://www.google.com/maps/search/?api=1&query=ベッセルイン栄駅前ホテル,名古屋市中区栄',
        icon: 'map',
      },
    ],
  },
  {
    time: '19:00〜21:00',
    badge: '確定',
    title: '心の休憩室ガルーバ で夕食',
    body: 'ガルーバで夕食。詳細は後日記入。',
    status: 'confirmed',
    links: [
      {
        label: '心の休憩室ガルーバ（公式）',
        href: 'https://garuva.info/',
        icon: 'web',
      },
      {
        label: '心の休憩室ガルーバ（地図）',
        href: 'https://www.google.com/maps/search/?api=1&query=心の休憩室ガルーバ+名古屋',
        icon: 'map',
      },
    ],
  },
  {
    time: '21:00〜0:00',
    badge: '確定',
    title: 'Dining&Bar BLACKSTONE でお酒',
    body: 'BLACKSTONEでお酒を楽しむ。詳細は後日記入。',
    status: 'confirmed',
    links: [
      {
        label: 'Dining&Bar BLACKSTONE（食べログ）',
        href: 'https://blackstone.gorp.jp/',
        icon: 'web',
      },
      {
        label: 'Dining&Bar BLACKSTONE（地図）',
        href: 'https://www.google.com/maps/search/?api=1&query=Dining+Bar+BLACKSTONE+名古屋+栄',
        icon: 'map',
      },
    ],
  },
  {
    time: '0:00',
    badge: '確定',
    title: 'ホテル帰宅 😏 ニンマリな夜',
    body: 'ホテルに戻る。ニンマリな夜。',
    status: 'confirmed',
  },
];

