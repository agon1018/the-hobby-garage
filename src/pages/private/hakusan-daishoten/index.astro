---
import RoomSidebar from '../../../components/RoomSidebar.astro';
import Layout from '../../../layouts/Layout.astro';

/* ----------------------------------------------------------------
   スケジュールデータ（日帰り）
   status: 'confirmed' = 確定  |  'pending' = 未定・後日決定
   badge:  '確定' | '目安' | '未定' | '当日'
---------------------------------------------------------------- */
type Link = {
  label: string;
  href: string;
  icon: 'map' | 'web' | 'train';
};

type HotelCandidate = {
  name: string;
  web: string;
  map: string;
};

type ScheduleItem = {
  time: string;
  badge: '確定' | '目安' | '未定' | '当日';
  title: string;
  body: string;
  status: 'confirmed' | 'pending';
  links?: Link[];
  hotels?: HotelCandidate[];
};

const schedule: ScheduleItem[] = [
  {
    time: '09:30',
    badge: '確定',
    title: '集合・富山IC 出発',
    body: '09:30集合、富山ICから出発。北陸自動車道を利用して金沢方面へ。金沢東ICから競馬場まで約6分。',
    status: 'confirmed',
    links: [
      {
        label: 'Google マップで経路を確認',
        href: 'https://www.google.com/maps/dir/?api=1&origin=富山インターチェンジ,富山県&destination=金沢東インターチェンジ,石川県&travelmode=driving',
        icon: 'map',
      },
    ],
  },
  {
    time: '11:00',
    badge: '確定',
    title: '金沢競馬場 開場・入場',
    body: '11時開場に合わせて金沢競馬場へ入場。午前のレースから観戦をスタートする。',
    status: 'confirmed',
    links: [
      {
        label: '金沢競馬場（公式）',
        href: 'https://www.kanazawakeiba.com/',
        icon: 'web',
      },
      {
        label: '金沢競馬場（地図）',
        href: 'https://www.google.com/maps/search/?api=1&query=金沢競馬場,石川県金沢市八田町西1',
        icon: 'map',
      },
    ],
  },
  {
    time: '昼',
    badge: '確定',
    title: '昼食（競馬場内）',
    body: '競馬場内で昼食を食べる。メニューは当日に決定する。',
    status: 'confirmed',
  },
  {
    time: '昼〜夕方',
    badge: '確定',
    title: '競馬観戦',
    body: '各レースを楽しみながら過ごす。メインレース「白山大賞典」は17時台に発走予定。当日は入場無料・来場者プレゼント・ガラポン抽選会・トークショーなどイベント盛りだくさん。',
    status: 'confirmed',
    links: [
      {
        label: '白山大賞典イベント情報（金沢競馬公式）',
        href: 'https://www.kanazawakeiba.com/event/info-38107/',
        icon: 'web',
      },
    ],
  },
  {
    time: '17時台',
    badge: '確定',
    title: 'GⅢ 白山大賞典 発走',
    body: 'メインレース「白山大賞典」GⅢ（ダート右回り2100m）を観戦。金沢競馬場唯一のダートグレード競走。',
    status: 'confirmed',
    links: [
      {
        label: '白山大賞典 2026（公式）',
        href: 'https://www.keiba.go.jp/dirtgraderace/2026/0922_hakusandaishoten/introduction.html',
        icon: 'web',
      },
    ],
  },
  {
    time: '17:30',
    badge: '確定',
    title: '金沢競馬場を出発',
    body: 'レース終了後、競馬場を出発。金沢市内の夕食場所へ向かう。',
    status: 'confirmed',
  },
  {
    time: '18:00',
    badge: '確定',
    title: '夕食（金沢市内）',
    body: '金沢市内で夕食。18時から食事スタート。店舗は後日決定する。',
    status: 'pending',
  },
  {
    time: '19:00',
    badge: '確定',
    title: '富山へ出発',
    body: '金沢東ICから北陸自動車道を利用して富山へ向かう。20時頃富山着予定。',
    status: 'confirmed',
    links: [
      {
        label: 'Google マップで帰路を確認',
        href: 'https://www.google.com/maps/dir/?api=1&origin=金沢東インターチェンジ,石川県&destination=富山インターチェンジ,富山県&travelmode=driving',
        icon: 'map',
      },
    ],
  },
  {
    time: '20:00頃〜0時',
    badge: '確定',
    title: '😏 ニンマリ（⭐ 星と）',
    body: '20時頃に 💧 泉と解散。⭐ 星と0時まで楽しむ。行き先はレースの結果次第！',
    status: 'confirmed',
    hotels: [
      {
        name: '🏆 勝ち → ホテルグレース',
        web: 'https://mshotels-group.com/grace/',
        map: 'https://www.google.com/maps/search/?api=1&query=ホテルグレース,富山県富山市黒崎410',
      },
      {
        name: '😢 負け → HOTEL FABULAN',
        web: 'https://hotelfabulan.jp/',
        map: 'https://www.google.com/maps/search/?api=1&query=DESIGN+HOTEL+FABULAN,富山県富山市島田142-4',
      },
    ],
  },
];

// ── 未決定項目一覧 ────────────────────────────────────────────
const pendingList = [
  { label: '金沢での夕食（店舗）' },
];
---

<Layout title="白山大賞典観戦 — プライベートの部屋" noindex>
  <RoomSidebar
    currentPath="/private/hakusan-daishoten"
    breadcrumbs={[
      { href: '/', label: '趣味のガレージ' },
      { href: '/private', label: 'プライベートの部屋' },
      { label: '白山大賞典観戦' },
    ]}
  >
    <main class="page">

      {/* ── ヘッダー ── */}
      <header class="title-head">
        <p class="label">Day Trip · 2026</p>
        <h1>白山大賞典 観戦</h1>
        <p class="subtitle">2026年9月22日（火・休日）｜3名（⭐ 星・💧 泉）｜富山から日帰り</p>
      </header>

      {/* ── 旅行概要カード ── */}
      <section class="overview-section">
        <h2 class="section-title"><span>遠征概要</span></h2>
        <div class="overview-grid">
          <div class="ov-item">
            <span class="ov-key">日程</span>
            <span class="ov-val">9月22日（火・休日）日帰り</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">参加者</span>
            <span class="ov-val">3名（⭐ 星・💧 泉）</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">出発地</span>
            <span class="ov-val">富山</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">移動手段</span>
            <span class="ov-val">自家用車（富山IC → 金沢東IC）</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">目的地</span>
            <span class="ov-val">金沢競馬場</span>
          </div>
          <div class="ov-item ov-item--highlight">
            <span class="ov-key">メインレース</span>
            <span class="ov-val">GⅢ 白山大賞典（17時台）ダート2100m</span>
          </div>
        </div>
      </section>

      {/* ── 凡例 ── */}
      <div class="legend">
        <span class="legend-item"><span class="badge badge--confirmed">確定</span>確定した予定</span>
        <span class="legend-item"><span class="badge badge--estimate">目安</span>おおよその時刻</span>
        <span class="legend-item"><span class="badge badge--pending">未定</span>後日決定する予定</span>
        <span class="legend-item"><span class="badge badge--today">当日</span>当日に決定する予定</span>
      </div>

      {/* ── タイムライン ── */}
      <section class="day-section">
        <div class="day-header">
          <div class="day-badge">9.22</div>
          <div class="day-info">
            <p class="day-date">9月22日（火・休日）</p>
            <p class="day-theme">金沢競馬場 日帰り遠征</p>
          </div>
        </div>

        <ol class="timeline">
          {schedule.map((item) => (
            <li class={`tl-item tl-item--${item.status}`}>
              <div class="tl-time">
                <span class="tl-time-text">{item.time}</span>
                <span class={`badge badge--${
                  item.badge === '確定' ? 'confirmed' :
                  item.badge === '目安' ? 'estimate' :
                  item.badge === '当日' ? 'today' : 'pending'
                }`}>{item.badge}</span>
              </div>
              <div class="tl-line" aria-hidden="true">
                <span class="tl-dot"></span>
              </div>
              <div class="tl-card">
                <h3 class="tl-title">{item.title}</h3>
                <p class="tl-body">{item.body}</p>
                {item.hotels && item.hotels.length > 0 && (
                  <ul class="hotel-list">
                    {item.hotels.map((hotel) => (
                      <li class="hotel-row">
                        <span class="hotel-name">{hotel.name}</span>
                        <span class="hotel-btns">
                          <a class="tl-link tl-link--web" href={hotel.web} target="_blank" rel="noopener noreferrer">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            公式
                          </a>
                          <a class="tl-link tl-link--map" href={hotel.map} target="_blank" rel="noopener noreferrer">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            地図
                          </a>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
                {item.links && item.links.length > 0 && (
                  <ul class="tl-links">
                    {item.links.map((link) => (
                      <li>
                        <a
                          class={`tl-link tl-link--${link.icon}`}
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.icon === 'map' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          )}
                          {link.icon === 'web' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                          )}
                          {link.icon === 'train' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="16" rx="3"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-2 2"/><path d="M16 19l2 2"/></svg>
                          )}
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {/* ── 未決定一覧 ── */}
      <section class="pending-section">
        <h2 class="section-title"><span>後日決定する項目</span></h2>
        <ul class="pending-list">
          {pendingList.map((item) => (
            <li class="pending-item">
              <span class="pending-day">未定</span>
              <span class="pending-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </section>

    </main>
  </RoomSidebar>
</Layout>

<style>
  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     ページ基盤
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .page {
    --teal:      #39869b;
    --teal-mid:  #8ec6d4;
    --teal-lt:   #cfdee1;
    --gold:      #da9444;
    --gold-lt:   #f0d09a;
    --ink:       #273044;
    --ink-mid:   #3e5560;
    --ink-lt:    #6b8594;
    --bg:        #f8faf9;
    --card-bg:   #ffffff;
    --pend-bg:   #f5f8f9;

    min-height: 100vh;
    padding: 2rem 1.2rem 4rem;
    color: var(--ink);
    font-family: 'BIZ UDPGothic', 'Noto Sans JP', sans-serif;
    background:
      radial-gradient(circle at 88% 14%, rgba(57, 134, 155, 0.13), transparent 38%),
      radial-gradient(circle at 12% 82%, rgba(218, 148, 68, 0.11), transparent 36%),
      var(--bg);
  }

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     ヘッダー
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .title-head {
    max-width: 980px;
    margin: 0 auto 1.2rem;
    padding: 1.05rem 1.2rem 1.15rem;
    border: 1px solid var(--teal-lt);
    border-radius: 1.15rem;
    background: var(--card-bg);
    box-shadow: 0 12px 26px rgba(39, 48, 68, 0.08);
    position: relative;
    overflow: hidden;
  }

  .title-head::after {
    content: '';
    position: absolute;
    inset: auto 12% 0;
    height: 4px;
    background: linear-gradient(90deg, var(--teal), var(--gold), var(--teal));
  }

  .label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal);
  }

  h1 {
    margin: 0.3rem 0 0.5rem;
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    letter-spacing: 0.04em;
    color: #204f5b;
  }

  .subtitle {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-mid);
    line-height: 1.6;
  }

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     セクション共通
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .overview-section,
  .day-section,
  .pending-section {
    max-width: 980px;
    margin: 0 auto 1.6rem;
  }

  .section-title {
    margin: 0 0 0.9rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .section-title::before,
  .section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--teal-lt);
  }

  .section-title::before { max-width: 1.4rem; flex: 0 0 1.4rem; }

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     概要グリッド
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .overview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.6rem;
  }

  .ov-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--teal-lt);
    border-radius: 0.8rem;
    background: var(--card-bg);
    box-shadow: 0 4px 10px rgba(39, 48, 68, 0.05);
  }

  .ov-item--highlight {
    border-color: var(--gold-lt);
    background: linear-gradient(135deg, #fffdf7, #fff9ee);
    box-shadow: 0 4px 12px rgba(218, 148, 68, 0.12);
  }

  .ov-key {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--teal);
    text-transform: uppercase;
  }

  .ov-item--highlight .ov-key { color: #b87630; }

  .ov-val {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.5;
  }

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     バッジ
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .badge {
    display: inline-block;
    padding: 0.12em 0.52em;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    border-radius: 999px;
    white-space: nowrap;
  }

  .badge--confirmed { background: #daf0f5; color: #1d6a7d; }
  .badge--estimate  { background: #ddf0e6; color: #1d6845; }
  .badge--pending   { background: #fde8d0; color: #935c18; }
  .badge--today     { background: #e8e4f8; color: #4c3a96; }

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     凡例
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .legend {
    max-width: 980px;
    margin: 0 auto 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.2rem;
    padding: 0.7rem 1rem;
    background: var(--card-bg);
    border: 1px solid var(--teal-lt);
    border-radius: 0.75rem;
    box-shadow: 0 4px 10px rgba(39, 48, 68, 0.04);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    font-size: 0.8rem;
    color: var(--ink-mid);
  }

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     日付ヘッダー
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .day-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.9rem;
    padding: 0.85rem 1.1rem;
    border-radius: 0.95rem;
    border: 1px solid var(--teal-lt);
    background: var(--card-bg);
    box-shadow: 0 6px 16px rgba(39, 48, 68, 0.07);
  }

  .day-badge {
    flex-shrink: 0;
    width: 3.2rem;
    height: 3.2rem;
    display: grid;
    place-items: center;
    border-radius: 0.7rem;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    background: linear-gradient(135deg, var(--teal), #2a6a7e);
    color: #fff;
    box-shadow: 0 6px 14px rgba(57, 134, 155, 0.3);
  }

  .day-date {
    margin: 0 0 0.18rem;
