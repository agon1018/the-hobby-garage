---
import RoomSidebar from '../../../components/RoomSidebar.astro';
import Layout from '../../../layouts/Layout.astro';

/* ----------------------------------------------------------------
   スケジュールデータ
   status: 'confirmed' = 確定  |  'pending' = 未定・後日決定
   badge:  '確定' | '目安' | '未定' | '当日'
   links:  { label, href, icon? } の配列（任意）
---------------------------------------------------------------- */
type Link = {
  label: string;
  href: string;
  icon: 'map' | 'web' | 'train';
};

type HotelCandidate = {
  name: string;
  web: string;
  map: string;
};

type ScheduleItem = {
  time: string;
  badge: '確定' | '目安' | '未定' | '当日';
  title: string;
  body: string;
  status: 'confirmed' | 'pending';
  links?: Link[];
  hotels?: HotelCandidate[];
};

// ── 10月17日（土） ────────────────────────────────────────────
const day1: ScheduleItem[] = [
  {
    time: '07:00',
    badge: '確定',
    title: '富山IC 出発',
    body: '富山から京都方面へ自家用車で出発。高速道路を利用して南下する。',
    status: 'confirmed',
    links: [
      {
        label: 'Google マップで経路を確認',
        href: 'https://www.google.com/maps/dir/?api=1&origin=富山インターチェンジ,富山県&destination=京都駅,京都府&travelmode=driving',
        icon: 'map',
      },
    ],
  },
  {
    time: '道中',
    badge: '当日',
    title: '休憩・昼食（道中）',
    body: 'SAやPAで適宜休憩。昼食も道中で当日に決定する。',
    status: 'pending',
  },
  {
    time: '11:00〜12:00頃',
    badge: '目安',
    title: '京都到着',
    body: '道路状況によって前後する可能性あり。京都駅周辺の駐車場へ車を停める。この時点ではホテルへは向かわず、京都駅周辺を起点に行動する。',
    status: 'confirmed',
  },
  {
    time: '昼',
    badge: '未定',
    title: '昼食',
    body: '京都駅周辺で昼食。店舗は後日決定する。',
    status: 'pending',
  },
  {
    time: '午後',
    badge: '確定',
    title: 'ショッピング・観光',
    body: '京都市内でショッピング・観光。衣類・雑貨などの買い物を中心に、若者向け・現代的なショップが多いエリアを優先する。具体的な店舗・ルートは後日決定。',
    status: 'confirmed',
  },
  {
    time: '15:00頃',
    badge: '未定',
    title: 'ホテルへ移動・チェックイン（候補3件）',
    body: 'いずれかのホテルへ移動してチェックイン。ホテル駐車場を利用する。チェックイン時刻に合わせて前後調整可能。',
    status: 'pending',
    hotels: [
      {
        name: 'インザグリーン京都・伏見',
        web: 'https://kyoto-inthegreen.com/',
        map: 'https://www.google.com/maps/search/?api=1&query=インザグリーン京都伏見,京都市伏見区竹田西小屋ノ内町1',
      },
      {
        name: '京都プラザホテル近鉄十条',
        web: 'https://kph-jujo.com/',
        map: 'https://www.google.com/maps/search/?api=1&query=京都プラザホテル近鉄十条,京都府京都市南区西九条菅田町1-1',
      },
      {
        name: 'ヴィアインプライム京都駅八条口',
        web: 'https://www.viainn.com/kyoto-h/',
        map: 'https://www.google.com/maps/search/?api=1&query=ヴィアインプライム京都駅八条口',
      },
    ],
  },
  {
    time: '夕方〜夜',
    badge: '未定',
    title: '夕食',
    body: '伏見周辺が候補エリア。店舗は友人と相談して後日決定する。',
    status: 'pending',
  },
  {
    time: '夜',
    badge: '確定',
    title: 'ホテルへ戻り就寝',
    body: '夕食後はホテルへ戻り宿泊。翌日の秋華賞に備える。',
    status: 'confirmed',
  },
];

// ── 10月18日（日） ────────────────────────────────────────────
const day2: ScheduleItem[] = [
  {
    time: '朝',
    badge: '未定',
    title: '朝食',
    body: '朝食は未定。ホテル内または周辺で検討する。',
    status: 'pending',
  },
  {
    time: 'チェックアウト後',
    badge: '確定',
    title: '車をホテルに置いて出発',
    body: 'チェックアウト後、車はホテル駐車場に置いたまま。公共交通機関で京都競馬場へ向かう。',
    status: 'confirmed',
  },
  {
    time: '出発時刻 未定',
    badge: '未定',
    title: 'ホテル → 丹波橋駅 or 伏見桃山駅',
    body: 'ホテルから最寄り駅（丹波橋駅 or 伏見桃山駅）への具体的な移動方法・出発時刻は後日調整。丹波橋駅から京阪本線で淀駅へ向かう。',
    status: 'pending',
    links: [
      {
        label: '丹波橋駅（Google マップ）',
        href: 'https://www.google.com/maps/search/?api=1&query=丹波橋駅,京都',
        icon: 'train',
      },
      {
        label: '伏見桃山駅（Google マップ）',
        href: 'https://www.google.com/maps/search/?api=1&query=伏見桃山駅,京都',
        icon: 'train',
      },
    ],
  },
  {
    time: '午前',
    badge: '確定',
    title: '電車で京阪「淀駅」へ',
    body: '京阪「淀駅」から徒歩約2分で京都競馬場へ到着。午前中から入場して競馬を楽しむ。',
    status: 'confirmed',
    links: [
      {
        label: '淀駅（Google マップ）',
        href: 'https://www.google.com/maps/search/?api=1&query=淀駅,京都',
        icon: 'train',
      },
    ],
  },
  {
    time: '昼',
    badge: '当日',
    title: '競馬場内で昼食',
    body: '昼食・競馬場内での食事は当日決定する。',
    status: 'pending',
  },
  {
    time: '午後',
    badge: '確定',
    title: 'GⅠ 秋華賞 観戦',
    body: 'メインレース「秋華賞」（牝馬三冠の最終戦）を観戦。その後も12Rまで全レースを楽しむ。',
    status: 'confirmed',
    links: [
      {
        label: '京都競馬場（JRA公式）',
        href: 'https://www.jra.go.jp/facilities/race/kyoto/',
        icon: 'web',
      },
    ],
  },
  {
    time: '12R終了後',
    badge: '確定',
    title: '競馬場でゆっくり過ごす',
    body: '12R終了後すぐには帰らない。競馬場内で少しゆっくり過ごし、混雑が落ち着いてから淀駅へ移動する。',
    status: 'confirmed',
  },
  {
    time: '夕方',
    badge: '確定',
    title: '淀駅 → ホテル方面へ',
    body: '淀駅から電車でホテル方面へ戻り、ホテルで車を回収する。',
    status: 'confirmed',
  },
  {
    time: '夕方〜夜',
    badge: '未定',
    title: '夕食',
    body: '夕食場所は友人と相談して後日決定する。食事を済ませてから富山へ出発する。',
    status: 'pending',
  },
  {
    time: '夜（未定）',
    badge: '確定',
    title: '富山へ帰宅',
    body: '京都南ICから高速道路で富山方面へ帰宅。富山到着時刻は未定。「21時着」を目標とせず、競馬場でゆっくり過ごし、夕食後に安全に帰ることを優先する。',
    status: 'confirmed',
    links: [
      {
        label: 'Google マップで経路を確認',
        href: 'https://www.google.com/maps/dir/?api=1&origin=京都南インターチェンジ,京都府&destination=富山インターチェンジ,富山県&travelmode=driving',
        icon: 'map',
      },
    ],
  },
];

// ── 未決定項目一覧 ────────────────────────────────────────────
const pendingList = [
  { day: '10/17', label: '宿泊ホテルの決定（インザグリーン京都・伏見 / 京都プラザホテル近鉄十条 / ヴィアインプライム京都駅八条口）' },
  { day: '10/17', label: '昼食（店舗）' },
  { day: '10/17', label: '京都でのショッピング店舗・詳細観光ルート' },
  { day: '10/17', label: '夕食（店舗）※伏見周辺が候補' },
  { day: '10/18', label: '朝食' },
  { day: '10/18', label: 'ホテルから最寄り駅までの移動方法・出発時刻' },
  { day: '10/18', label: '競馬場での昼食' },
  { day: '10/18', label: '競馬終了後の休憩時間の目安' },
  { day: '10/18', label: '夕食（店舗）' },
  { day: '両日', label: '富山到着時刻' },
];
---

<Layout title="京都競馬場旅行しおり — プライベートの部屋" noindex>
  <RoomSidebar
    currentPath="/private/kyoto-racecourse"
    breadcrumbs={[
      { href: '/', label: '趣味のガレージ' },
      { href: '/private', label: 'プライベートの部屋' },
      { label: '京都競馬場旅行' },
    ]}
  >
    <main class="page">

      {/* ── ヘッダー ── */}
      <header class="title-head">
        <p class="label">Travel · 2026</p>
        <h1>京都競馬場旅行</h1>
        <p class="subtitle">2026年10月17日（土）〜18日（日）｜2名｜富山出発</p>
      </header>

      {/* ── 旅行概要カード ── */}
      <section class="overview-section">
        <h2 class="section-title"><span>旅行概要</span></h2>
        <div class="overview-grid">
          <div class="ov-item">
            <span class="ov-key">日程</span>
            <span class="ov-val">10月17日（土）〜18日（日）1泊2日</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">参加者</span>
            <span class="ov-val">2名</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">出発地</span>
            <span class="ov-val">富山</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">移動手段</span>
            <span class="ov-val">自家用車（競馬当日は電車）</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">宿泊先</span>
            <span class="ov-val">候補3件で検討中</span>
          </div>
          <div class="ov-item ov-item--highlight">
            <span class="ov-key">メインイベント</span>
            <span class="ov-val">GⅠ 秋華賞（10月18日・京都競馬場）</span>
          </div>
        </div>
      </section>

      {/* ── 凡例 ── */}
      <div class="legend">
        <span class="legend-item"><span class="badge badge--confirmed">確定</span>確定した予定</span>
        <span class="legend-item"><span class="badge badge--estimate">目安</span>おおよその時刻</span>
        <span class="legend-item"><span class="badge badge--pending">未定</span>後日決定する予定</span>
        <span class="legend-item"><span class="badge badge--today">当日</span>当日に決定する予定</span>
      </div>

      {/* ── DAY 1 ── */}
      <section class="day-section">
        <div class="day-header day-header--1">
          <div class="day-badge">DAY 1</div>
          <div class="day-info">
            <p class="day-date">10月17日（土）</p>
            <p class="day-theme">京都観光・ショッピング</p>
          </div>
        </div>

        <ol class="timeline">
          {day1.map((item) => (
            <li class={`tl-item tl-item--${item.status}`}>
              <div class="tl-time">
                <span class="tl-time-text">{item.time}</span>
                <span class={`badge badge--${
                  item.badge === '確定' ? 'confirmed' :
                  item.badge === '目安' ? 'estimate' :
                  item.badge === '当日' ? 'today' : 'pending'
                }`}>{item.badge}</span>
              </div>
              <div class="tl-line" aria-hidden="true">
                <span class="tl-dot"></span>
              </div>
              <div class="tl-card">
                <h3 class="tl-title">{item.title}</h3>
                <p class="tl-body">{item.body}</p>
                {item.hotels && item.hotels.length > 0 && (
                  <ul class="hotel-list">
                    {item.hotels.map((hotel) => (
                      <li class="hotel-row">
                        <span class="hotel-name">{hotel.name}</span>
                        <span class="hotel-btns">
                          <a class="tl-link tl-link--web" href={hotel.web} target="_blank" rel="noopener noreferrer">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            公式
                          </a>
                          <a class="tl-link tl-link--map" href={hotel.map} target="_blank" rel="noopener noreferrer">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            地図
                          </a>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
                {item.links && item.links.length > 0 && (
                  <ul class="tl-links">
                    {item.links.map((link) => (
                      <li>
                        <a
                          class={`tl-link tl-link--${link.icon}`}
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.icon === 'map' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          )}
                          {link.icon === 'web' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                          )}
                          {link.icon === 'train' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="16" rx="3"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-2 2"/><path d="M16 19l2 2"/></svg>
                          )}
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {/* ── DAY 2 ── */}
      <section class="day-section">
        <div class="day-header day-header--2">
          <div class="day-badge">DAY 2</div>
          <div class="day-info">
            <p class="day-date">10月18日（日）</p>
            <p class="day-theme">京都競馬場 · GⅠ 秋華賞</p>
          </div>
        </div>

        <ol class="timeline">
          {day2.map((item) => (
            <li class={`tl-item tl-item--${item.status}`}>
              <div class="tl-time">
                <span class="tl-time-text">{item.time}</span>
                <span class={`badge badge--${
                  item.badge === '確定' ? 'confirmed' :
                  item.badge === '目安' ? 'estimate' :
                  item.badge === '当日' ? 'today' : 'pending'
                }`}>{item.badge}</span>
              </div>
              <div class="tl-line" aria-hidden="true">
                <span class="tl-dot"></span>
              </div>
              <div class="tl-card">
                <h3 class="tl-title">{item.title}</h3>
                <p class="tl-body">{item.body}</p>
                {item.hotels && item.hotels.length > 0 && (
                  <ul class="hotel-list">
                    {item.hotels.map((hotel) => (
                      <li class="hotel-row">
                        <span class="hotel-name">{hotel.name}</span>
                        <span class="hotel-btns">
                          <a class="tl-link tl-link--web" href={hotel.web} target="_blank" rel="noopener noreferrer">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            公式
                          </a>
                          <a class="tl-link tl-link--map" href={hotel.map} target="_blank" rel="noopener noreferrer">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            地図
                          </a>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
                {item.links && item.links.length > 0 && (
                  <ul class="tl-links">
                    {item.links.map((link) => (
                      <li>
                        <a
                          class={`tl-link tl-link--${link.icon}`}
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.icon === 'map' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          )}
                          {link.icon === 'web' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                          )}
                          {link.icon === 'train' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="16" rx="3"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-2 2"/><path d="M16 19l2 2"/></svg>
                          )}
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {/* ── 未決定一覧 ── */}
      <section class="pending-section">
        <h2 class="section-title"><span>後日決定する項目</span></h2>
        <ul class="pending-list">
          {pendingList.map((item) => (
            <li class="pending-item">
              <span class="pending-day">{item.day}</span>
              <span class="pending-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </section>

    </main>
  </RoomSidebar>
</Layout>

<style>
  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     ページ基盤
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .page {
    --teal:      #39869b;
    --teal-mid:  #8ec6d4;
    --teal-lt:   #cfdee1;
    --gold:      #da9444;
    --gold-lt:   #f0d09a;
    --ink:       #273044;
    --ink-mid:   #3e5560;
    --ink-lt:    #6b8594;
    --bg:        #f8faf9;
    --card-bg:   #ffffff;
    --pend-bg:   #f5f8f9;

    min-height: 100vh;
    padding: 2rem 1.2rem 4rem;
    color: var(--ink);
