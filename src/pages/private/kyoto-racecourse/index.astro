---
import RoomSidebar from '../../../components/RoomSidebar.astro';
import Layout from '../../../layouts/Layout.astro';

/* ----------------------------------------------------------------
   スケジュールデータ
   status: 'confirmed' = 確定  |  'pending' = 未定・後日決定
   badge:  '確定' | '目安' | '未定' | '当日'
   links:  { label, href, icon? } の配列（任意）
---------------------------------------------------------------- */
type Link = {
  label: string;
  href: string;
  icon: 'map' | 'web' | 'train';
};

type ScheduleItem = {
  time: string;
  badge: '確定' | '目安' | '未定' | '当日';
  title: string;
  body: string;
  status: 'confirmed' | 'pending';
  links?: Link[];
};

// ── 10月17日（土） ────────────────────────────────────────────
const day1: ScheduleItem[] = [
  {
    time: '07:00',
    badge: '確定',
    title: '富山IC 出発',
    body: '富山から京都方面へ自家用車で出発。高速道路を利用して南下する。',
    status: 'confirmed',
    links: [
      {
        label: 'Google マップで経路を確認',
        href: 'https://www.google.com/maps/dir/?api=1&origin=富山インターチェンジ,富山県&destination=レンタル着物岡本%20嵐山店,京都府&travelmode=driving',
        icon: 'map',
      },
    ],
  },
  {
    time: '道中',
    badge: '当日',
    title: '休憩・昼食（道中）',
    body: 'SAやPAで適宜休憩。昼食も道中で当日に決定する。',
    status: 'pending',
  },
  {
    time: '11:00〜12:00頃',
    badge: '目安',
    title: '嵐山到着・周辺駐車場に駐車',
    body: '道路状況によって前後する可能性あり。レンタル着物岡本 嵐山店周辺の候補駐車場から選んで車を停める。',
    status: 'confirmed',
    links: [
      {
        label: 'レンタル着物岡本 嵐山店（Google マップ）',
        href: 'https://maps.app.goo.gl/UkLd9yvfqrBFhPY76',
        icon: 'map',
      },
      {
        label: 'コンセプト嵐電嵐山駅北コインパーキング',
        href: 'https://maps.app.goo.gl/GTF5HS5hR4zdxNs86',
        icon: 'map',
      },
      {
        label: 'akippa三煌ガレージsg',
        href: 'https://maps.app.goo.gl/vc8FZ8yUch557Rb89',
        icon: 'map',
      },
      {
        label: '三井のリパーク 嵐電嵐山駅西駐車場',
        href: 'https://maps.app.goo.gl/NmzMCF6AUHePietV7',
        icon: 'map',
      },
      {
        label: 'タイムズ嵯峨天龍寺第2',
        href: 'https://maps.app.goo.gl/CARnvdJmyLD3pmk18',
        icon: 'map',
      },
      {
        label: 'コンセプト嵯峨天龍寺コインパーキング',
        href: 'https://maps.app.goo.gl/gkQWy4qF1tk5xQrZ6',
        icon: 'map',
      },
      {
        label: '三井のリパーク JR嵯峨嵐山駅南駐車場',
        href: 'https://maps.app.goo.gl/maqPsCGAyRYwXboU6',
        icon: 'map',
      },
      {
        label: 'Park1st.阪急嵐山駅前',
        href: 'https://maps.app.goo.gl/Ekm8at7Hp75eEGu8A',
        icon: 'map',
      },
    ],
  },
  {
    time: '午後',
    badge: '確定',
    title: '着物レンタル・嵐山観光',
    body: 'レンタル着物岡本 嵐山店で着物をレンタルし、着物姿で嵐山を巡る。',
    status: 'confirmed',
    links: [
      {
        label: 'レンタル着物岡本 嵐山店（公式）',
        href: 'https://www.okamoto-kimono.com/storeinfo/arashiyama.html',
        icon: 'web',
      },
      {
        label: '店舗（Google マップ）',
        href: 'https://maps.app.goo.gl/UkLd9yvfqrBFhPY76',
        icon: 'map',
      },
    ],
  },
  {
    time: '午後',
    badge: '確定',
    title: '嵐山で食べ歩き',
    body: '嵐山で食べ歩きを楽しむ。',
    status: 'confirmed',
    links: [
      {
        label: '嵐山の食べ歩きマップ23選',
        href: 'https://www.leafkyoto.net/240814-kyoto-arashiyamafood/',
        icon: 'web',
      },
      {
        label: '京都・嵐山で食べ歩き！おすすめ12選',
        href: 'https://media.kepco.co.jp/town-and-life/17762372',
        icon: 'web',
      },
      {
        label: '嵐山駅周辺の食べ歩きグルメ',
        href: 'https://tabelog.com/matome/26062/',
        icon: 'web',
      },
    ],
  },
  {
    time: '17:00頃',
    badge: '確定',
    title: '嵐山月灯路のチケットを購入',
    body: '嵐山月灯路の券売所へ行き、チケットを購入する。',
    status: 'confirmed',
    links: [
      {
        label: '嵐山月灯路（公式）',
        href: 'https://arashiyama-tsukitouro.jp/',
        icon: 'web',
      },
      {
        label: '券売所（Google マップ）',
        href: 'https://maps.app.goo.gl/WDXiNvYiSBduQ32A7',
        icon: 'map',
      },
    ],
  },
  {
    time: '17:00〜20:00頃',
    badge: '確定',
    title: '嵐山月灯路を楽しむ',
    body: '嵐山月灯路を20時頃まで楽しむ。',
    status: 'confirmed',
  },
  {
    time: '20:00頃',
    badge: '確定',
    title: '淀キャッスルインへ移動',
    body: '嵐山から京阪パーキング淀駅前へ移動して車を駐車し、淀キャッスルインへ向かう。',
    status: 'confirmed',
    links: [
      {
        label: '京阪パーキング淀駅前（公式）',
        href: 'https://www.keihan-t.co.jp/kp/parking/search/2020-08-05-101',
        icon: 'web',
      },
      {
        label: '駐車場（Google マップ）',
        href: 'https://www.google.com/maps/search/?api=1&query=京阪パーキング淀駅前,京都府京都市伏見区淀池上町147-2',
        icon: 'map',
      },
    ],
  },
  {
    time: '到着後',
    badge: '確定',
    title: '淀キャッスルイン チェックイン',
    body: '駐車場から淀キャッスルインへ移動してチェックイン。',
    status: 'confirmed',
    links: [
      {
        label: '淀キャッスルイン（公式）',
        href: 'https://yodo-castle-inn.com/',
        icon: 'web',
      },
      {
        label: 'ホテル（Google マップ）',
        href: 'https://www.google.com/maps/search/?api=1&query=淀キャッスルイン,京都府京都市伏見区淀池上町147-24',
        icon: 'map',
      },
    ],
  },
  {
    time: '22:00頃',
    badge: '確定',
    title: 'ホテルへ戻り就寝',
    body: 'ホテルで就寝し、翌日の秋華賞に備える。',
    status: 'confirmed',
  },
];

// ── 10月18日（日） ────────────────────────────────────────────
const day2: ScheduleItem[] = [
  {
    time: '07:00頃',
    badge: '確定',
    title: '起床',
    body: '起床して出発準備をする。',
    status: 'confirmed',
  },
  {
    time: '08:00',
    badge: '確定',
    title: 'チェックアウト',
    body: '淀キャッスルインをチェックアウト。車は京阪パーキング淀駅前に駐車したままにする。',
    status: 'confirmed',
  },
  {
    time: '08:00頃',
    badge: '確定',
    title: '徒歩で京都競馬場へ',
    body: 'ホテルから徒歩で京都競馬場へ向かい、8時頃の到着を目指す。',
    status: 'confirmed',
    links: [
      {
        label: '京都競馬場（Google マップ）',
        href: 'https://www.google.com/maps/search/?api=1&query=京都競馬場,京都府京都市伏見区葭島渡場島町32',
        icon: 'map',
      },
    ],
  },
  {
    time: '08:00頃',
    badge: '確定',
    title: '京都競馬場 到着',
    body: '京都競馬場に到着。午前中から入場して競馬を楽しむ。',
    status: 'confirmed',
    links: [
      {
        label: '淀駅（Google マップ）',
        href: 'https://www.google.com/maps/search/?api=1&query=淀駅,京都',
        icon: 'train',
      },
    ],
  },
  {
    time: '昼',
    badge: '当日',
    title: '競馬場内で昼食',
    body: '昼食・競馬場内での食事は当日決定する。',
    status: 'pending',
  },
  {
    time: '午後',
    badge: '確定',
    title: 'GⅠ 秋華賞 観戦',
    body: 'メインレース「秋華賞」（牝馬三冠の最終戦）を観戦。11R終了後に京都競馬場を出発する。',
    status: 'confirmed',
    links: [
      {
        label: '京都競馬場（JRA公式）',
        href: 'https://www.jra.go.jp/facilities/race/kyoto/',
        icon: 'web',
      },
    ],
  },
  {
    time: '11R終了後',
    badge: '確定',
    title: '京阪パーキング淀駅前へ戻る',
    body: '徒歩で京阪パーキング淀駅前へ戻り、車を回収する。',
    status: 'confirmed',
  },
  {
    time: '夕方',
    badge: '確定',
    title: '伏見稲荷大社へ移動',
    body: '京阪パーキング淀駅前から車で伏見稲荷大社参拝駐車場へ向かう。',
    status: 'confirmed',
    links: [
      {
        label: '駐車場から伏見稲荷大社への経路',
        href: 'https://www.google.com/maps/dir/?api=1&origin=京阪パーキング淀駅前,京都府京都市伏見区淀池上町147-2&destination=伏見稲荷大社参拝駐車場,京都府京都市伏見区深草薮之内町68&travelmode=driving',
        icon: 'map',
      },
    ],
  },
  {
    time: '夕方〜夜',
    badge: '確定',
    title: '伏見稲荷大社を参拝・ライトアップを楽しむ',
    body: '伏見稲荷大社を参拝し、ライトアップを楽しむ。',
    status: 'confirmed',
    links: [
      {
        label: '伏見稲荷大社（公式）',
        href: 'https://inari.jp/',
        icon: 'web',
      },
      {
        label: '伏見稲荷大社（Google マップ）',
        href: 'https://maps.app.goo.gl/G5D34raH15btmGWBA',
        icon: 'map',
      },
    ],
  },
  {
    time: '夜（未定）',
    badge: '確定',
    title: '富山へ帰宅',
    body: '伏見稲荷大社を出発後、京都南ICから高速道路で富山方面へ帰宅する。富山到着時刻は未定。',
    status: 'confirmed',
    links: [
      {
        label: 'Google マップで経路を確認',
        href: 'https://www.google.com/maps/dir/?api=1&origin=京都南インターチェンジ,京都府&destination=富山インターチェンジ,富山県&travelmode=driving',
        icon: 'map',
      },
    ],
  },
];

// ── 未決定項目一覧 ────────────────────────────────────────────
const pendingList = [
  { day: '10/17', label: '嵐山で利用する駐車場の選定' },
  { day: '10/18', label: '競馬場での昼食' },
  { day: '両日', label: '富山到着時刻' },
];
---

<Layout title="京都競馬場旅行しおり — プライベートの部屋" noindex>
  <RoomSidebar
    currentPath="/private/kyoto-racecourse"
    breadcrumbs={[
      { href: '/', label: '趣味のガレージ' },
      { href: '/private', label: 'プライベートの部屋' },
      { label: '京都競馬場旅行' },
    ]}
  >
    <main class="page">

      {/* ── ヘッダー ── */}
      <header class="title-head">
        <p class="label">Travel · 2026</p>
        <h1>京都競馬場旅行</h1>
        <p class="subtitle">2026年10月17日（土）〜18日（日）｜2名（⭐）｜富山出発</p>
      </header>

      {/* ── 旅行概要カード ── */}
      <section class="overview-section">
        <h2 class="section-title"><span>旅行概要</span></h2>
        <div class="overview-grid">
          <div class="ov-item">
            <span class="ov-key">日程</span>
            <span class="ov-val">10月17日（土）〜18日（日）1泊2日</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">参加者</span>
            <span class="ov-val">2名（⭐）</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">出発地</span>
            <span class="ov-val">富山</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">移動手段</span>
            <span class="ov-val">自家用車（競馬場へは徒歩）</span>
          </div>
          <div class="ov-item">
            <span class="ov-key">宿泊先</span>
            <span class="ov-val">淀キャッスルイン</span>
          </div>
          <div class="ov-item ov-item--highlight">
            <span class="ov-key">メインイベント</span>
            <span class="ov-val">GⅠ 秋華賞（10月18日・京都競馬場）</span>
          </div>
        </div>
      </section>

      {/* ── 凡例 ── */}
      <div class="legend">
        <span class="legend-item"><span class="badge badge--confirmed">確定</span>確定した予定</span>
        <span class="legend-item"><span class="badge badge--estimate">目安</span>おおよその時刻</span>
        <span class="legend-item"><span class="badge badge--pending">未定</span>後日決定する予定</span>
        <span class="legend-item"><span class="badge badge--today">当日</span>当日に決定する予定</span>
      </div>

      {/* ── DAY 1 ── */}
      <section class="day-section">
        <div class="day-header day-header--1">
          <div class="day-badge">DAY 1</div>
          <div class="day-info">
            <p class="day-date">10月17日（土）</p>
            <p class="day-theme">京都観光・ショッピング</p>
          </div>
        </div>

        <ol class="timeline">
          {day1.map((item) => (
            <li class={`tl-item tl-item--${item.status}`}>
              <div class="tl-time">
                <span class="tl-time-text">{item.time}</span>
                <span class={`badge badge--${
                  item.badge === '確定' ? 'confirmed' :
                  item.badge === '目安' ? 'estimate' :
                  item.badge === '当日' ? 'today' : 'pending'
                }`}>{item.badge}</span>
              </div>
              <div class="tl-line" aria-hidden="true">
                <span class="tl-dot"></span>
              </div>
              <div class="tl-card">
                <h3 class="tl-title">{item.title}</h3>
                <p class="tl-body">{item.body}</p>
                {item.links && item.links.length > 0 && (
                  <ul class="tl-links">
                    {item.links.map((link) => (
                      <li>
                        <a
                          class={`tl-link tl-link--${link.icon}`}
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.icon === 'map' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          )}
                          {link.icon === 'web' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                          )}
                          {link.icon === 'train' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="16" rx="3"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-2 2"/><path d="M16 19l2 2"/></svg>
                          )}
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {/* ── DAY 2 ── */}
      <section class="day-section">
        <div class="day-header day-header--2">
          <div class="day-badge">DAY 2</div>
          <div class="day-info">
            <p class="day-date">10月18日（日）</p>
            <p class="day-theme">京都競馬場 · GⅠ 秋華賞</p>
          </div>
        </div>

        <ol class="timeline">
          {day2.map((item) => (
            <li class={`tl-item tl-item--${item.status}`}>
              <div class="tl-time">
                <span class="tl-time-text">{item.time}</span>
                <span class={`badge badge--${
                  item.badge === '確定' ? 'confirmed' :
                  item.badge === '目安' ? 'estimate' :
                  item.badge === '当日' ? 'today' : 'pending'
                }`}>{item.badge}</span>
              </div>
              <div class="tl-line" aria-hidden="true">
                <span class="tl-dot"></span>
              </div>
              <div class="tl-card">
                <h3 class="tl-title">{item.title}</h3>
                <p class="tl-body">{item.body}</p>
                {item.links && item.links.length > 0 && (
                  <ul class="tl-links">
                    {item.links.map((link) => (
                      <li>
                        <a
                          class={`tl-link tl-link--${link.icon}`}
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.icon === 'map' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          )}
                          {link.icon === 'web' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                          )}
                          {link.icon === 'train' && (
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="16" rx="3"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-2 2"/><path d="M16 19l2 2"/></svg>
                          )}
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {/* ── 未決定一覧 ── */}
      <section class="pending-section">
        <h2 class="section-title"><span>後日決定する項目</span></h2>
        <ul class="pending-list">
          {pendingList.map((item) => (
            <li class="pending-item">
              <span class="pending-day">{item.day}</span>
              <span class="pending-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </section>

    </main>
  </RoomSidebar>
</Layout>

<style>
  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     ページ基盤
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .page {
    --teal:      #39869b;
    --teal-mid:  #8ec6d4;
    --teal-lt:   #cfdee1;
    --gold:      #da9444;
    --gold-lt:   #f0d09a;
    --ink:       #273044;
    --ink-mid:   #3e5560;
