---
import { createHash } from 'node:crypto';

const password = String(import.meta.env.PUBLIC_HORSE_ROOM_PASSWORD ?? '').trim();
const passwordHash = password
  ? createHash('sha256').update(password).digest('hex')
  : '';
const configured = Boolean(passwordHash);
---

<script is:inline>
  try {
    if (localStorage.getItem('hobby-garage-horse-unlocked') === '1') {
      document.documentElement.dataset.horseUnlocked = 'true';
    }
  } catch {
    /* ignore */
  }
</script>

<div class="horse-gate" data-horse-gate data-password-hash={passwordHash} data-configured={configured ? 'true' : 'false'}>
  <section class="lock-screen" data-lock-screen>
    <div class="lock-card">
      <p class="label">Horse Room</p>
      <h1>競馬の部屋</h1>
      <p class="lead">この部屋はパスワードで保護しています。</p>
      {configured ? (
        <form data-lock-form>
          <label>
            <span>パスワード</span>
            <input
              type="password"
              name="password"
              autocomplete="current-password"
              required
              autofocus
            />
          </label>
          <p class="error" data-lock-error hidden>パスワードが違います。</p>
          <button type="submit">入室する</button>
        </form>
      ) : (
        <p class="error is-visible">パスワードがまだ設定されていません。`.env` の `PUBLIC_HORSE_ROOM_PASSWORD` を設定してください。</p>
      )}
    </div>
  </section>

  <div class="gate-content" data-gate-content>
    <div class="gate-toolbar">
      <button type="button" data-lock-again>鍵をかける</button>
    </div>
    <slot />
  </div>
</div>

<script>
  const STORAGE_KEY = 'hobby-garage-horse-unlocked';

  async function sha256Hex(value: string): Promise<string> {
    const buffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value));
    return [...new Uint8Array(buffer)].map((byte) => byte.toString(16).padStart(2, '0')).join('');
  }

  function setUnlocked(unlocked: boolean) {
    if (unlocked) {
      document.documentElement.dataset.horseUnlocked = 'true';
      try {
        localStorage.setItem(STORAGE_KEY, '1');
      } catch {
        /* ignore */
      }
      return;
    }

    delete document.documentElement.dataset.horseUnlocked;
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      /* ignore */
    }
  }

  function initHorseRoomGate() {
    document.querySelectorAll<HTMLElement>('[data-horse-gate]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const form = root.querySelector<HTMLFormElement>('[data-lock-form]');
      const error = root.querySelector<HTMLElement>('[data-lock-error]');
      const expectedHash = root.dataset.passwordHash ?? '';

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const input = form.querySelector<HTMLInputElement>('input[name="password"]');
        const value = input?.value ?? '';
        const got = await sha256Hex(value);
        if (!expectedHash || got !== expectedHash) {
          if (error) error.hidden = false;
          if (input) {
            input.value = '';
            input.focus();
          }
          return;
        }

        if (error) error.hidden = true;
        setUnlocked(true);
      });

      root.querySelector('[data-lock-again]')?.addEventListener('click', () => {
        setUnlocked(false);
        const input = root.querySelector<HTMLInputElement>('input[name="password"]');
        if (input) input.value = '';
        input?.focus();
      });
    });
  }

  initHorseRoomGate();
</script>

<style>
  .horse-gate {
    --horse-palette-1: #16824a;
    --horse-palette-2: #e85c1a;
    --horse-palette-3: #0e5c34;
    --horse-silks: linear-gradient(
      90deg,
      #e85c1a 0%,
      #e85c1a 14%,
      #ffffff 14%,
      #ffffff 28%,
      #16824a 28%,
      #16824a 72%,
      #ffffff 72%,
      #ffffff 86%,
      #e85c1a 86%,
      #e85c1a 100%
    );
  }

  .lock-screen {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1.2rem;
    background:
      linear-gradient(155deg, rgba(22, 130, 74, 0.12) 0%, rgba(255, 255, 255, 0) 42%),
      linear-gradient(335deg, rgba(232, 92, 26, 0.08) 0%, rgba(255, 255, 255, 0) 38%),
      #f6fbf7;
    font-family: 'BIZ UDPGothic', 'Noto Sans JP', sans-serif;
    color: #1c2e24;
  }

  .lock-card {
    width: min(100%, 420px);
    background: #fff;
    border: 1px solid #c9e2d3;
    border-radius: 1.15rem;
    padding: 1.2rem 1.2rem 1.3rem;
    box-shadow: 0 12px 24px rgba(14, 92, 52, 0.08);
    position: relative;
    overflow: hidden;
  }

  .lock-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 6px;
    background: var(--horse-silks);
  }

  .label {
    margin: 0.35rem 0 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--horse-palette-1);
    font-weight: 700;
    font-size: 0.8rem;
  }

  h1 {
    margin: 0.3rem 0 0.55rem;
    color: var(--horse-palette-3);
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    letter-spacing: 0.04em;
    font-size: 1.7rem;
  }

  .lead {
    margin: 0 0 1rem;
    line-height: 1.7;
    font-size: 0.92rem;
  }

  form {
    display: grid;
    gap: 0.7rem;
  }

  label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 800;
    color: #4d735c;
  }

  input {
    font: inherit;
    font-weight: 600;
    color: #1c2e24;
    padding: 0.55rem 0.7rem;
    border: 1px solid #c9e2d3;
    border-radius: 0.7rem;
    background: #fff;
  }

  input:focus-visible {
    outline: 3px solid var(--horse-palette-1);
    outline-offset: 2px;
  }

  button[type='submit'] {
    font: inherit;
    font-weight: 800;
    color: #fff;
    background: var(--horse-palette-1);
    border: none;
    border-radius: 999px;
    padding: 0.55rem 1rem;
    cursor: pointer;
  }

  button[type='submit']:hover,
  button[type='submit']:focus-visible {
    background: var(--horse-palette-3);
  }

  button[type='submit']:focus-visible {
    outline: 3px solid var(--horse-palette-2);
    outline-offset: 2px;
  }

  .error {
    margin: 0;
    color: var(--horse-palette-2);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .error.is-visible {
    margin-top: 0.4rem;
  }

  .gate-content {
    display: none;
  }

  .lock-screen {
    display: none;
  }

  :global(html:not([data-horse-unlocked])) .lock-screen {
    display: grid;
  }

  :global(html[data-horse-unlocked]) .gate-content {
    display: block;
  }

  .gate-toolbar {
    max-width: 980px;
    margin: 0 auto;
    padding: 0.7rem 1.2rem 0;
    display: flex;
    justify-content: flex-end;
    font-family: 'BIZ UDPGothic', 'Noto Sans JP', sans-serif;
  }

  .gate-toolbar button {
    font: inherit;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--horse-palette-3);
    background: #fff;
    border: 1px solid #c9e2d3;
    border-radius: 999px;
    padding: 0.28rem 0.7rem;
    cursor: pointer;
  }

  .gate-toolbar button:hover,
  .gate-toolbar button:focus-visible {
    border-color: var(--horse-palette-2);
    background: #eef8f1;
    outline: none;
  }

  @media (max-width: 700px) {
    .lock-screen {
      padding: 1rem 0.8rem;
    }

    .lock-card {
      padding: 1rem 0.9rem 1.1rem;
    }

    h1 {
      font-size: 1.4rem;
    }

    .gate-toolbar {
      padding: 0.55rem 0.8rem 0;
    }
  }
</style>
