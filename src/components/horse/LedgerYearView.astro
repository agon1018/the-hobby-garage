---
import HorseSectionNav from './HorseSectionNav.astro';
import LedgerTable from './LedgerTable.astro';
import {
  formatLedgerValue,
  ledgerBooks,
  ledgerPath,
  type LedgerBook,
  type LedgerYear,
} from '../../data/horseLedger';

interface Props {
  book: LedgerBook;
  ledger: LedgerYear;
}

const { book, ledger } = Astro.props;
const yearNumbers = book.years.map((item) => item.year);
const yearIndex = yearNumbers.indexOf(ledger.year);
const newerYear = yearIndex > 0 ? yearNumbers[yearIndex - 1] : undefined;
const olderYear = yearIndex >= 0 && yearIndex < yearNumbers.length - 1
  ? yearNumbers[yearIndex + 1]
  : undefined;
---

<header class="title-head">
  <div class="title-row">
    <div>
      <p class="label">Horse Ledger</p>
      <h1>収支</h1>
    </div>
    <HorseSectionNav current="ledger" />
  </div>
  <nav class="books" aria-label="人数の選択">
    {ledgerBooks.map((item) => (
      <a
        class:list={['book', { current: item.id === book.id }]}
        href={ledgerPath(item.id, ledger.year)}
        aria-current={item.id === book.id ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
  <nav class="years" aria-label="年の選択">
    {yearNumbers.map((year) => (
      <a
        class:list={['year', { current: year === ledger.year }]}
        href={ledgerPath(book.id, year)}
        aria-current={year === ledger.year ? 'page' : undefined}
      >
        {year}年
      </a>
    ))}
  </nav>
</header>

<section class="block">
  <div class="head">
    <h2>{book.label}　{ledger.year}年</h2>
    <div class="step">
      {newerYear && <a href={ledgerPath(book.id, newerYear)}>新しい年（{newerYear}）</a>}
      {olderYear && <a href={ledgerPath(book.id, olderYear)}>古い年（{olderYear}）</a>}
    </div>
  </div>
  <LedgerTable ledger={ledger} />
  {ledger.notes.length > 0 && (
    <ul class="notes">
      {ledger.notes.map((note) => (
        <li>
          <span>{note.label}</span>
          <b>{formatLedgerValue(note.value)}</b>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .title-head,
  .block {
    max-width: 1100px;
    margin: 0 auto;
  }

  .title-head {
    border: 1px solid #c9e2d3;
    border-radius: 1.15rem;
    padding: 1rem 1.15rem 1.05rem;
    background:
      radial-gradient(circle at 88% 14%, rgba(22, 130, 74, 0.16), transparent 34%),
      radial-gradient(circle at 12% 85%, rgba(232, 92, 26, 0.12), transparent 34%),
      #ffffff;
    box-shadow: 0 12px 24px rgba(14, 92, 52, 0.08);
    position: relative;
    overflow: hidden;
  }

  .title-head::after {
    content: '';
    position: absolute;
    inset: auto 14% 0 14%;
    height: 6px;
    background: var(--horse-silks);
  }

  .label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
    color: var(--horse-palette-1);
    font-weight: 700;
    font-size: 0.8rem;
  }

  h1 {
    margin: 0.35rem 0 0;
    color: var(--horse-palette-3);
    font-size: clamp(1.75rem, 3.5vw, 2.6rem);
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    letter-spacing: 0.04em;
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .books {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
    margin-top: 0.95rem;
  }

  .book {
    display: grid;
    place-items: center;
    padding: 0.58rem 0.8rem;
    border-radius: 0.85rem;
    border: 1px solid #c9e2d3;
    background: #fff;
    color: var(--horse-palette-3);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 800;
  }

  .book:hover,
  .book:focus-visible {
    border-color: var(--horse-palette-2);
    background: #eef8f1;
    outline: none;
  }

  .book.current {
    background: var(--horse-palette-3);
    border-color: var(--horse-palette-3);
    color: #fff;
  }

  .years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .year {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.62rem;
    border-radius: 999px;
    border: 1px solid #c9e2d3;
    background: #fff;
    color: var(--horse-palette-1);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .year:hover,
  .year:focus-visible {
    border-color: var(--horse-palette-2);
    background: #eef8f1;
    outline: none;
  }

  .year.current {
    background: var(--horse-palette-3);
    border-color: var(--horse-palette-3);
    color: #fff;
  }

  .block {
    margin-top: 1.15rem;
    background: #fff;
    border: 1px solid #c9e2d3;
    border-radius: 1rem;
    padding: 1rem 1.05rem 1.1rem;
    box-shadow: 0 8px 16px rgba(14, 92, 52, 0.07);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.75rem;
  }

  h2 {
    margin: 0;
    font-size: 1.12rem;
    color: var(--horse-palette-3);
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    letter-spacing: 0.04em;
  }

  .step {
    display: flex;
    gap: 0.7rem;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .step a {
    color: var(--horse-palette-1);
    text-decoration: none;
  }

  .step a:hover,
  .step a:focus-visible {
    color: var(--horse-palette-2);
  }

  .notes {
    margin: 0.85rem 0 0;
    padding: 0.7rem 0.85rem;
    list-style: none;
    display: grid;
    gap: 0.35rem;
    background: #eef8f1;
    border-radius: 0.7rem;
    color: #1c2e24;
    font-size: 0.82rem;
  }

  .notes li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .notes span {
    color: #4d735c;
    font-weight: 700;
  }

  .notes b {
    font-variant-numeric: tabular-nums;
    color: var(--horse-palette-3);
  }

  @media (max-width: 700px) {
    .title-head {
      border-radius: 0.9rem;
      padding: 0.78rem 0.82rem 0.84rem;
    }

    h1 {
      font-size: 1.45rem;
      margin: 0.22rem 0 0;
    }

    .book {
      font-size: 0.86rem;
      padding: 0.5rem 0.5rem;
    }

    .block {
      padding: 0.85rem 0.75rem;
      border-radius: 0.85rem;
    }
  }
</style>
