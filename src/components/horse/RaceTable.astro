---
import type { RaceResult } from '../../data/horses';

interface Props {
  races: RaceResult[];
}

const { races } = Astro.props;
---

<section class="block" id="races">
  <h2>レース情報</h2>
  {races.length === 0 ? (
    <p class="empty">レース情報はまだありません。</p>
  ) : (
    <div class="table-wrap">
      <table>
        <caption class="visually-hidden">出走成績一覧</caption>
        <thead>
          <tr>
            <th>出走日</th>
            <th>場所</th>
            <th>区</th>
            <th>レース名</th>
            <th>天候<br />状態</th>
            <th>コース</th>
            <th>Ｒ</th>
            <th>枠<br />番</th>
            <th>頭<br />人</th>
            <th>着</th>
            <th>騎手<br />斤量</th>
            <th>タイム<br />(着差)</th>
            <th>上り</th>
            <th>体重</th>
            <th>備考</th>
          </tr>
        </thead>
        <tbody>
          {races.map((race) => (
            <tr>
              <td>{race.date}</td>
              <td>{race.venue}</td>
              <td>{race.classLabel}</td>
              <td class="name">{race.raceName}</td>
              <td>
                <span class="stack">
                  <b>{race.weather}</b>
                  <small>{race.going}</small>
                </span>
              </td>
              <td>
                <span class="stack">
                  <b>{race.surface}</b>
                  <small>{race.distance}</small>
                </span>
              </td>
              <td>{race.raceNumber}</td>
              <td>
                <span class="stack">
                  <b>{race.bracket}</b>
                  <small>{race.horseNumber}</small>
                </span>
              </td>
              <td>
                <span class="stack">
                  <b>{race.fieldSize}</b>
                  <small>{race.popularity}</small>
                </span>
              </td>
              <td class="finish">{race.finish}</td>
              <td>
                <span class="stack">
                  <b>{race.jockey}</b>
                  <small>{race.carriedWeight}</small>
                </span>
              </td>
              <td>
                <span class="stack">
                  <b>{race.time}</b>
                  <small>({race.margin})</small>
                </span>
              </td>
              <td>{race.last3f}</td>
              <td>{race.horseWeight}</td>
              <td>{race.note ?? ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</section>

<style>
  .block {
    max-width: 980px;
    margin: 1rem auto 0;
    background: #fff;
    border: 1px solid #c9e2d3;
    border-radius: 1rem;
    padding: 1rem 1.05rem 1.1rem;
    scroll-margin-top: 0.8rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    color: var(--horse-palette-3);
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    letter-spacing: 0.04em;
  }

  .empty {
    margin: 0;
    color: #4d735c;
    line-height: 1.7;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 980px;
    font-size: 0.78rem;
  }

  th,
  td {
    border-bottom: 1px solid #d5eadc;
    padding: 0.5rem 0.38rem;
    text-align: center;
    vertical-align: middle;
    line-height: 1.4;
    white-space: nowrap;
  }

  th {
    color: #3d6b4e;
    font-weight: 800;
    background: #e8f6ee;
  }

  td {
    color: #1c2e24;
  }

  td.name {
    text-align: left;
    font-weight: 700;
  }

  td.finish {
    font-weight: 800;
    color: var(--horse-palette-3);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 0.04rem;
  }

  .stack b {
    font-weight: 700;
  }

  .stack small {
    color: #5a7a66;
    font-size: 0.72rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .block {
      padding: 0.85rem 0.75rem;
      border-radius: 0.85rem;
    }

    table {
      font-size: 0.7rem;
    }
  }
</style>
